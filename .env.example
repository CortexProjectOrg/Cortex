# Google Authentication Secrets (configured in Vercel project environment variables)
GOOGLE_AUTH_API_KEY=your_google_cloud_api_key_here
GOOGLE_AUTH_CLIENT_API_KEY=your_google_oauth_client_id.apps.googleusercontent.com

# Optional Vercel Storage (one-click attach via Vercel Dashboard Storage tab)
# If using Vercel Blob:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# If using Upstash Redis / Vercel KV:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
