# Server: Google OAuth web client ID (not an API key).
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Browser: same public OAuth client ID. Never put a secret in a VITE_* variable.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Server/migration only. Supply through your deployment environment or secret manager.
DATABASE_URL=postgresql://user:password@your-neon-host/neondb?sslmode=require
# POSTGRES_URL, NEON_DATABASE_URL, POSTGRES_PRISMA_URL are accepted legacy database aliases.
# GOOGLE_AUTH_CLIENT_API_KEY is an accepted legacy client-ID alias; prefer GOOGLE_CLIENT_ID.
# Blob, KV and Google API-key variables are no longer used.
