# Google Authentication (OAuth 2.0 Client ID for Web Applications)
# 1. In Google Cloud Console (console.cloud.google.com), navigate to APIs & Services > Credentials
# 2. Click "Create Credentials" > "OAuth client ID"
# 3. Set Application type: "Web application" (NOT Desktop, Android, or Service Account)
# 4. Under "Authorized JavaScript origins", add your local dev URL and production domain:
#    - http://localhost:5173
#    - https://your-project.vercel.app
# 5. Copy the Client ID (ends with .apps.googleusercontent.com) and paste below (no quotes)
GOOGLE_AUTH_CLIENT_API_KEY=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com

# Optional Google Cloud API Key (for server tokeninfo endpoint, if needed)
GOOGLE_AUTH_API_KEY=your_google_cloud_api_key_here

# Neon Database URL (automatically provided by Vercel Neon integration or set manually)
DATABASE_URL=postgres://user:password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require
# Alternative aliases also supported:
# POSTGRES_URL=postgres://...

# Optional Fallback Storages
# If using Vercel Blob:
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...
# If using Upstash Redis / Vercel KV:
# KV_REST_API_URL=https://...
# KV_REST_API_TOKEN=...
